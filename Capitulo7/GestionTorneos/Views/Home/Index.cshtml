@model List<GestionTorneos.Models.Torneo>
@{
    ViewData["Title"] = "Home Page";
}
<h1> TORNEOS</h1>
<table class="table table-striped table-hover align-middle">
    <tr> 
        <th> Nombre</th>
        <th> Fecha de Inicio</th>
        <th> Fecha de Fin</th>
        <th> Juego del Torneo</th>
        <th> Acciones</th>

    </tr>
    @foreach(var t in Model)
    {
        <tr>
            <td> @t.Nombre </td>
            <td> @t.FechaInicio </td>
            <td> @t.FechaFin </td>
            <td> @t.JuegoNombre </td>
            <td> <a asp-controller="Torneo" asp-action="EliminarTorneo" asp-route-id="@t.TorneoId" class="btn btn-danger">Eliminar torneo</a> </td>
        </tr>
    }
</table>

<div class="text-center">
    <h1 class="display-2">Gestión de Torneos</h1>
    <a asp-controller="Juego" asp-action="Create" class="btn btn-primary"> Añadir un Juego nuevo</a>
    <a asp-controller="Torneo" asp-action="Create" class="btn btn-primary"> Añadir un Torneo nuevo</a>
    
</div>
@if (TempData["Mensaje"] != null)
{
    <script>
        alert("@Html.Raw(TempData["Mensaje"])");
    </script>

}