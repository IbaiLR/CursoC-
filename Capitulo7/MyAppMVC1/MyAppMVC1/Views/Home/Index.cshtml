@{
    ViewData["Title"] = "Home Page";
}
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Accessor


<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

@if (Accessor.HttpContext.Session.GetString("usuarioNombre") == null)
{
    <a asp-controller="Usuario" asp-action="Crear" class="btn btn-primary"> Registrarse</a>
<a asp-controller="Usuario" asp-action="IniciarSesion" class="btn btn-primary">  Iniciar Sesión</a>
}
<a asp-controller="Usuario" asp-action="Index" class=" btn btn-primary"> Ver usuarios</a> <!-- No haría falta poner el asp-action porque es index y si no hay nada es lo que coge po defecto->

@if (Accessor.HttpContext.Session.GetString("usuarioNombre") != null)
{
    <a asp-controller="Usuario" asp-action="cerrarSesion"> Cerrar sesión</a>
}